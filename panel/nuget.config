<?xml version="1.0" encoding="utf-8"?>
<!--
  NuGet 源。

  第一条是仓库里已经下载好的本地包目录（.wasdk/feed，由之前的构建攒下来的），
  第二条是国内镜像。留着本地源有两个好处：还原不依赖网络；版本是钉死的
  （panel.vcxproj 里写的是精确版本），不会哪天偷偷换成新版。

  注：官方源 api.nuget.org 在这台机器上会 302 到 nuget.azure.cn，所以直接用镜像。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="glance-local" value="..\.wasdk\feed" />
    <add key="nuget-mirror" value="https://nuget.azure.cn/v3/index.json" />
  </packageSources>
</configuration>
